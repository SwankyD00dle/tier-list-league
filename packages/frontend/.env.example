BACKEND_URL=http://localhost:3001

# Optional. Leave unset to call the backend through the Next.js /api/* rewrite.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Public app URL at BOTH build and start. Optional for root-routed local development.
# A trailing slash is accepted. Rebuild whenever the pathname changes.
# APP_PUBLIC_URL=https://example.com/ingress/my-app
