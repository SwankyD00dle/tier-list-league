{
  "name": "@tier-list-league/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "node ../../node_modules/tsc-native/bin/tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "exports": {
    "./schema": "./src/database/schema/types.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "1.0.0-rc.4"
    "vitest": "^4.1.10",
  }
}
