{
  "name": "@tier-list-league/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "node ../../node_modules/tsc-native/bin/tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:default-avatars": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --import tsx src/scripts/seed-default-avatars.ts"
  },
  "exports": {
    "./schema": "./src/database/schema/types.ts"
  },
  "dependencies": {
    "@tier-list-league/api-schema": "*",
    "@vercel/blob": "^2.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "^6.2.4",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "1.0.0-rc.4",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
