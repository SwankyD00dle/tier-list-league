PORT=3001
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false

# Vercel Blob store read-write token. Create a Blob store in the Vercel dashboard
# (Storage tab) and copy its BLOB_READ_WRITE_TOKEN. Used by
# `npm run seed:default-avatars` to upload the default profile pictures.
BLOB_READ_WRITE_TOKEN=
